# Copy to .env and edit. All values are optional — these are the defaults.
# Env vars override the matching keys in categories.json `settings`.

# ── LLM (any local Ollama model or OpenAI-compatible endpoint) ──
TECHPULSE_LLM_PROVIDER=ollama                                   # ollama | ollama-chat | openai
TECHPULSE_MODEL=llama3.1:8b                                     # local default; swap for any pulled model
TECHPULSE_LLM_URL=http://127.0.0.1:11434/api/generate
# TECHPULSE_LLM_API_KEY=sk-...                                  # required for openai-compatible endpoints
TECHPULSE_LLM_MAX_TOKENS=512                                    # higher cap = no more truncated summaries
TECHPULSE_LLM_RETRIES=3
TECHPULSE_LLM_TIMEOUT=90

# ── Scheduler (app.py serve / installed service) ──
TECHPULSE_SCHEDULE=06:30                                        # daily run time, 24h local
TECHPULSE_JSON=1                                                # also write techpulse_daily_data.json
TECHPULSE_RUN_IDEA_RADAR=0                                      # also run idea_radar.py after each briefing
TECHPULSE_TELEGRAM=0                                            # deliver via Telegram
# TECHPULSE_NO_LLM=0                                            # 1 = raw RSS summaries, no LLM

# ── Idea Radar project discovery (optional) ──
# TECHPULSE_PROJECT_PATHS=/path/to/projects/skills:/another/skills

# ── Telegram delivery (optional) ──
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
